{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "gt-stock-manager"
      }
    }
  ],
  "services": {
    "gt-stock-manager": {
      "root": ".",
      "entrypoint": "api/index.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  }
}
